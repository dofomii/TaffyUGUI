{
  "name": "com.dofomii.taffyugui",
  "version": "1.0.0",
  "displayName": "TaffyUGUI",
  "description": "Responsive Flexbox, Grid, Block, intrinsic measurement, and responsive layout for Unity uGUI, powered by Rust and Taffy.",
  "unity": "2021.3",
  "keywords": [
    "ugui",
    "layout",
    "flexbox",
    "grid",
    "taffy",
    "rust"
  ],
  "author": {
    "name": "dofomii",
    "url": "https://github.com/dofomii"
  },
  "license": "MIT",
  "dependencies": {
    "com.unity.ugui": "1.0.0",
    "com.unity.textmeshpro": "3.0.6"
  },
  "documentationUrl": "https://github.com/dofomii/TaffyUGUI/tree/main/UnityPackage/Documentation~",
  "changelogUrl": "https://github.com/dofomii/TaffyUGUI/blob/main/CHANGELOG.md",
  "licensesUrl": "https://github.com/dofomii/TaffyUGUI/blob/main/LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/dofomii/TaffyUGUI.git"
  },
  "samples": [
    {
      "displayName": "Flex Quick Start",
      "description": "A runtime bootstrap that creates a visible Flex row with TaffyLayoutGroup and TaffyLayoutItem.",
      "path": "Samples~/Flex Quick Start"
    },
    {
      "displayName": "Grid and Responsive",
      "description": "A runtime Grid example with fraction tracks, Calc sizing, and a narrow responsive profile.",
      "path": "Samples~/Grid and Responsive"
    },
    {
      "displayName": "Custom Measurement",
      "description": "A custom ITaffyMeasurementProvider example showing intrinsic measurement without native callbacks.",
      "path": "Samples~/Custom Measurement"
    }
  ]
}
